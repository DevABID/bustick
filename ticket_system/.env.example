# Copy this file to .env and fill in your values. Never commit .env.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the React app and this API are reachable (used for payment redirects)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Booking rules
SEAT_HOLD_MINUTES=10
MAX_SEATS_PER_BOOKING=4
RETURN_CUTOFF_HOURS=12
CURRENCY=BDT
BRAND_NAME=BusTick

# Help page contact form messages are emailed here
SUPPORT_EMAIL=arabid8427@gmail.com

# Payments: sslcommerz | stripe | demo   (demo only works with DEBUG=True)
PAYMENT_PROVIDER=demo

# SSLCommerz — free sandbox account: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True

# Stripe — test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. Console backend prints emails in the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For Gmail: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BusTick <no-reply@example.com>
